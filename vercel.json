{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/quiz/",
      "permanent": false
    },
    {
      "source": "/gashapon",
      "destination": "/gashapon/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/quiz/",
      "destination": "/quiz/index.html"
    },
    {
      "source": "/gashapon/",
      "destination": "/gashapon/index.html"
    }
  ]
}